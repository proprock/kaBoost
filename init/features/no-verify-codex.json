{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/kaboost_no_verify_guard.py\"",
            "command_windows": "py -3 scripts\\kaboost_no_verify_guard.py"
          }
        ]
      }
    ]
  }
}
