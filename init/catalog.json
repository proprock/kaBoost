    },
    {
      "id": "compaction",
      "number": 42,
      "scope": "global",
      "group": "Personal",
      "title": "Compaction and handoff",
      "summary": "What to keep and drop when compacting context.",
      "edits": [
        {
          "name": "claude",
          "target": "{home}/.claude/CLAUDE.md",
          "mode": "append",
          "body": "compaction.md",
          "version": 1,
          "tool": "claude"
        },
        {
          "name": "codex",
          "target": "{home}/.codex/AGENTS.md",
          "mode": "append",
          "body": "compaction.md",
          "version": 1,
          "tool": "codex"
        }
      ]
    },
    {
      "id": "delegation",
      "number": 43,
      "scope": "global",
      "group": "Personal",
      "title": "Delegation",
      "summary": "Delegate bounded subtasks; the main agent keeps architecture and review.",
      "edits": [
