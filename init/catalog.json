      "id": "reasoning-effort",
      "number": 41,
      "scope": "global",
      "group": "Personal",
      "title": "Reasoning effort",
      "summary": "Escalate effort only for architecture and hard debugging, and say so.",
      "edits": [
        {
          "name": "claude",
          "target": "{home}/.claude/CLAUDE.md",
          "mode": "append",
          "body": "reasoning-effort.md",
          "version": 1,
          "tool": "claude"
        },
        {
          "name": "codex",
          "target": "{home}/.codex/AGENTS.md",
          "mode": "append",
          "body": "reasoning-effort.md",
          "version": 1,
